# Variables NON secrètes de la pile Docker Compose.
# Copier en `.env` (fait par `python infra/gen-dev-secrets.py` s'il manque).
# Les secrets vont dans `.env.secrets/`, un fichier par secret, jamais ici.

# Environnement : dev, demo ou prod. DEMO_MODE est exigé par ENV=demo (AD-14).
ENV=demo
DEMO_MODE=true
LOG_LEVEL=INFO

# Base de données (les mots de passe sont dans .env.secrets/).
DB_HOST=db
DB_PORT=5432
DB_NAME=terangacycle
# Rôles PostgreSQL : noms fixés par infra/db/initdb/20-roles.sh, à ne pas changer seuls.
# DB_APP_USER=teranga_app
# DB_MIGRATOR_USER=teranga_migrator

# Valkey (file arq, limites de débit).
VALKEY_URL=redis://valkey:6379/0

# Stockage objet Garage : endpoint interne (path-style), région, bucket privé créé
# au démarrage. Identifiants S3 dans .env.secrets/ (s3_access_key_id, s3_secret_access_key).
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=terangacycle-photos

# Version du Modèle livré, exposée par GET /v1/config (vide tant qu'aucun Modèle).
# MODEL_VERSION=

# Zone active (table `zones`, chargée par la migration 0002 depuis OpenStreetMap) : l'API
# refuse de démarrer si aucune Zone ne porte cet identifiant.
ACTIVE_ZONE_ID=dakar
# Précision de Position (mètres) au-delà de laquelle la PWA invite à patienter et le
# Signalement est marqué « position imprécise » (exactement ce seuil : pas de drapeau).
REPORT_ACCURACY_FLAG_M=50

# Noms servis par Caddy en HTTPS : la PWA et l'API sur APP_HOST, les photos sur MEDIA_HOST.
# Chrome résout *.localhost vers 127.0.0.1 ; Caddy leur émet un certificat de son CA interne.
# En démo réelle : de vrais domaines, et Caddy obtient un certificat Let's Encrypt.
APP_HOST=app.localhost
MEDIA_HOST=media.localhost

# Ports publiés sur l'hôte (à changer s'ils sont déjà pris).
HTTP_PORT=80
HTTPS_PORT=443
DB_LOCAL_PORT=5432
# API S3 de Garage sur 127.0.0.1 (tests d'intégration du stockage).
GARAGE_LOCAL_PORT=3900
# Valkey sur 127.0.0.1 (tests d'intégration de la file arq).
VALKEY_LOCAL_PORT=6379
