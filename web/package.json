    "react-i18next": "18.0.3",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.95.0",
    "tailwindcss": "4.3.5",
